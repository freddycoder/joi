# Copie ce fichier sous le nom .env et remplis les valeurs.

# Clé API AssemblyAI (https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=

# Modèle de reconnaissance vocale AssemblyAI (le français demande un modèle « Pro »)
ASSEMBLYAI_MODELE=universal-3-6-pro
# Noms propres ou mots inventés à bien reconnaître, séparés par des virgules (« Joi » est toujours inclus).
# Ex. : JOI_MOTS_CLES=Lysdor, ErabliereApi
JOI_MOTS_CLES=

# Voix de Joi (edge-tts). Autres choix : fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural
JOI_VOIX=fr-CA-SylvieNeural
# Débit de la voix, ex. +0%, +10%, -5%
JOI_DEBIT=+0%

# Modèle Copilot. Vide = choix automatique de Copilot.
JOI_MODELE=

JOI_PORT=8049

# Mode écoute : durée des segments audio enregistrés dans donnees/enregistrements/ (en minutes)
JOI_SEGMENT_MINUTES=30
# Mode écoute : modèle de la transcription différée (fin d'écoute), avec reconnaissance des voix
ASSEMBLYAI_MODELES_DIFFERES=universal-3-5-pro
# Mode écoute : garder l'audio après sa transcription (oui/non). Par défaut, seul le texte est gardé.
JOI_GARDER_AUDIO=non
# Commandes vocales « Joi, écoute seulement » et « Joi, reviens » (oui/non).
# « Joi, reviens » est reconnu hors ligne par Vosk : son modèle français (~40 Mo) est téléchargé une fois.
JOI_COMMANDE_VOCALE=oui
