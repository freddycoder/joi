# Copie ce fichier sous le nom .env et remplis les valeurs.

# Clé API AssemblyAI (https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=

# Modèle de reconnaissance vocale AssemblyAI en temps réel (le français demande un modèle « Pro » ou 3.7).
# À essayer : assemblyai-stt-3-7-realtime-agent (même prix, ignore mieux les voix de fond). À vérifier :
# qu'il accepte la langue et les réglages de fin de tour (configuration affichée à l'ouverture de session).
ASSEMBLYAI_MODELE=universal-3-6-pro
# Noms propres ou mots inventés à bien reconnaître, séparés par des virgules (« Joi » est toujours inclus).
# Ex. : JOI_MOTS_CLES=Lysdor, ErabliereApi
JOI_MOTS_CLES=
# Fin de tour : quand AssemblyAI décide que tu as fini de parler. Vide = la valeur d'AssemblyAI.
# Mode : min_latency, balanced (défaut d'AssemblyAI) ou max_accuracy. Silences en millisecondes :
# minimum avant de pouvoir finir un tour (50 à 10000), et maximum qui finit le tour quoi qu'il arrive
# (1280 en balanced). Trop court, Joi te coupe la parole : la ligne « Latence » du journal aide à régler.
JOI_FIN_TOUR_MODE=
JOI_FIN_TOUR_SILENCE_MIN_MS=
JOI_FIN_TOUR_SILENCE_MAX_MS=

# Voix de Joi (edge-tts). Autres choix : fr-FR-DeniseNeural, fr-FR-VivienneMultilingualNeural
JOI_VOIX=fr-CA-SylvieNeural
# Débit de la voix, ex. +0%, +10%, -5%
JOI_DEBIT=+0%

# Moteur de synthèse vocale : edge (par défaut, gratuit) ou assemblyai (utilise ASSEMBLYAI_API_KEY).
JOI_TTS=edge
# Voix AssemblyAI : voix de la bibliothèque (ex. aai-donatien) ou slug d'une voix créée dans le tableau de bord
# (bouton « Copy voice ID »). Le débit JOI_DEBIT ne s'applique pas à AssemblyAI.
JOI_VOIX_ASSEMBLYAI=aai-donatien
# Langue de la voix AssemblyAI (nom anglais complet : french, english, spanish…)
JOI_LANGUE_ASSEMBLYAI=french

# Modèle Copilot. Vide = choix automatique de Copilot.
JOI_MODELE=

JOI_PORT=8049

# Mode écoute : durée des segments audio enregistrés dans donnees/enregistrements/ (en minutes)
JOI_SEGMENT_MINUTES=30
# Mode écoute : pendant une longue écoute, Joi apprend ce qu'elle a entendu toutes les N minutes d'audio,
# sans attendre la fin (arrondi aux segments terminés). 0 = seulement à la fin de l'écoute.
JOI_APPRENDRE_MINUTES=60
# Mode écoute : modèle(s) de la transcription différée (fin d'écoute), avec reconnaissance des voix,
# par ordre de préférence. universal-3-5-pro est déprécié : il ne sert plus qu'en secours.
ASSEMBLYAI_MODELES_DIFFERES=assemblyai-stt-3-7,universal-3-5-pro
# Mode écoute : garder l'audio après sa transcription (oui/non). Par défaut, seul le texte est gardé.
JOI_GARDER_AUDIO=non
# Commandes vocales « Joi, écoute seulement » et « Joi, reviens » (oui/non).
# « Joi, reviens » est reconnu hors ligne par Vosk : son modèle français (~40 Mo) est téléchargé une fois.
JOI_COMMANDE_VOCALE=oui

# Reconnaissance des voix en mode écoute (oui/non) : empreintes vocales calculées sur l'ordinateur
# (SpeechBrain ECAPA, ~80 Mo téléchargés une fois dans donnees/empreintes/modele/). Joi apprend ta voix
# pendant vos conversations, et regroupe les autres voix (anonymes) sur toute la journée.
JOI_RECONNAISSANCE_VOIX=oui
# Seuils de similarité (de -1 à 1), à régler avec : python -m joi.empreintes rejouer AAAA-MM-JJ
JOI_VOIX_SEUIL_TOI=0.40
JOI_VOIX_SEUIL_SEGMENT=0.25
JOI_VOIX_SEUIL_JOURNEE=0.45
# Parole totale dans la journée (en s) pour compter comme interlocuteur ; en dessous : voix de passage
JOI_VOIX_INTERLOCUTEUR_S=30
# Fenêtres de parole (en s) : durée minimale et maximale, silence entre deux mots qui coupe une fenêtre
JOI_VOIX_FENETRE_MIN_S=1.5
JOI_VOIX_FENETRE_MAX_S=4
JOI_VOIX_SILENCE_S=0.7
# Heure du bilan des voix de la journée (ajouté au résumé), après quoi les empreintes anonymes sont effacées
JOI_FIN_JOURNEE=18:00

# Compte de Joi (optionnel) : microsoft, ou vide (pas de compte : Joi fonctionne comme avant).
# iCloud viendra plus tard. Mise en place : README, « Le compte de Joi ».
JOI_COMPTE=
# Adresse de Joi (sert d'indice de connexion et à reconnaître son agenda)
JOI_COURRIEL=
# Ton adresse : destinataire toujours permis, invitée aux rappels, propriétaire de l'agenda partagé
JOI_COURRIEL_PROPRIETAIRE=
# Autres adresses auxquelles Joi peut écrire (après ta confirmation), séparées par des virgules
JOI_COURRIEL_DESTINATAIRES=
# Vérification des nouveaux courriels pendant la conversation (en minutes, 0 = seulement au réveil)
JOI_COURRIEL_VERIFIER_MINUTES=60
# Fuseau horaire de l'agenda
JOI_FUSEAU=America/Toronto
# Microsoft : ID d'application (client) de l'inscription Entra
JOI_MS_CLIENT_ID=
